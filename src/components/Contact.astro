---
---
<section class="cta-band" id="contact">
  <div class="wrap contact-inner">
    <div class="contact-info">
      <span class="kicker">GET IN TOUCH</span>
      <h3>Ready to make compliance one less thing to worry about?</h3>
      <p>Book a consultation with our panel of CPAs and legal counsel. We typically respond within one business day.</p>
      <ul class="contact-details">
        <li>
          <span class="ci-label">Email</span>
          <a href="mailto:maelenamedez@yahoo.com" id="emailLink">maelenamedez@yahoo.com</a>
        </li>
        <li>
          <span class="ci-label">Phone / Viber</span>
          <a href="tel:+639171234567">+63 917 123 4567</a>
        </li>
        <li>
          <span class="ci-label">Office</span>
          <span>Unit 1204, One Corporate Centre, Ortigas Center, Pasig City, Metro Manila, Philippines</span>
        </li>
        <li>
          <span class="ci-label">Hours</span>
          <span>Monday&ndash;Friday, 8:30 AM&ndash;5:30 PM (PHT)</span>
        </li>
      </ul>
    </div>
    <form class="contact-form" id="contactForm" aria-label="Consultation request form">
      <label for="cf-name">Name<span aria-hidden="true">*</span></label>
      <input type="text" id="cf-name" name="name" required autocomplete="name" />

      <label for="cf-email">Email<span aria-hidden="true">*</span></label>
      <input type="email" id="cf-email" name="email" required autocomplete="email" />

      <label for="cf-company">Company (optional)</label>
      <input type="text" id="cf-company" name="company" autocomplete="organization" />

      <label for="cf-message">How can we help?<span aria-hidden="true">*</span></label>
      <textarea id="cf-message" name="message" rows="4" required></textarea>

      <button type="submit" class="btn-primary">Request a Consultation</button>
      <p class="form-note" id="cf-note">We'll open your email client with these details filled in &mdash; nothing is sent automatically.</p>
    </form>
  </div>
</section>

<script>
  // Opens Gmail's compose window directly in the visitor's browser
  // instead of letting the OS prompt "Select an app to open this mailto link".
  function openWebmail(event: Event, toAddress: string, subject?: string, body?: string) {
    event.preventDefault();

    subject = subject || 'Consultation Inquiry';
    body = body || '';

    var url =
      'https://mail.google.com/mail/?view=cm&fs=1&to=' +
      encodeURIComponent(toAddress) +
      '&su=' +
      encodeURIComponent(subject) +
      '&body=' +
      encodeURIComponent(body);

    window.open(url, '_blank', 'noopener,noreferrer');
    return false;
  }

  document.getElementById('emailLink')?.addEventListener('click', function (e) {
    openWebmail(e, 'maelenamedez@yahoo.com');
  });

  // Contact form: builds a mailto/Gmail-compose message from the visitor's input
  (function () {
    var form = document.getElementById('contactForm') as HTMLFormElement | null;
    if (!form) return;
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
      var email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
      var company = (form.elements.namedItem('company') as HTMLInputElement).value.trim();
      var message = (form.elements.namedItem('message') as HTMLTextAreaElement).value.trim();

      var body =
        'Name: ' + name + '\n' +
        'Email: ' + email + '\n' +
        (company ? 'Company: ' + company + '\n' : '') +
        '\n' + message;

      openWebmail(e, 'maelenamedez@yahoo.com', 'Consultation Request from ' + (name || 'Website Visitor'), body);
    });
  })();
</script>
