---
const people = [
  {
    img: '/images/team-1.jpg',
    name: 'Mark Lucine R. Aldabon',
    cred: 'CPA',
    role: 'Technical Accounting Lead',
    quote: 'I dig into the numbers until every entry makes sense, because clean books are the foundation of every filing we sign off on.',
  },
  {
    img: '/images/team-2.jpg',
    name: 'May Joyce Galanto',
    cred: 'CPA, MBA',
    role: 'Tax Advisory & BIR Systems Consultant',
    quote: "I've worked the BIR's systems enough times to know exactly where clients get stuck. My job is getting you through it faster.",
  },
  {
    img: '/images/team-3.jpg',
    name: 'Rodita Galanto',
    cred: 'CPA',
    role: 'Practice Lead',
    quote: 'A good engagement runs on trust between the team and the client. I make sure both stay aligned from day one.',
  },
  {
    img: '/images/team-4.jpg',
    name: 'Ma. Elena Medez',
    cred: 'CPA, MBA',
    role: 'Operations & Compliance Director',
    quote: "When an issue surfaces, we don't wait for it to grow. I move on it the same day.",
  },
  {
    img: '/images/team-5.jpg',
    name: 'Ramiro Galanto',
    cred: 'CPA',
    role: 'Founder',
    quote: "I started this firm on one idea: your business should never carry compliance risk alone. That's still true today.",
  },
  {
    img: '/images/team-6.jpg',
    name: 'Atty. Erna D. Galanto',
    cred: 'Legal Counsel',
    role: 'Head of Legal & Regulatory Affairs',
    quote: "Compliance isn't just numbers, it's law. I make sure every recommendation we give stands up to it.",
  },
];
---
<section class="team" id="team">
  <div class="wrap">
    <div class="section-head">
      <span class="kicker">LEADERSHIP &amp; EXPERT PANEL</span>
      <h2>A multidisciplinary team, in your corner</h2>
      <p>Certified Public Accountants, legal counsel, and business strategists working as one panel.</p>
    </div>
    <div class="carousel" id="carousel">
      <div class="carousel-viewport" id="carViewport">
        {people.map((p) => (
          <div class="slide">
            <div class="slide-photo">
              <img src={p.img} alt={p.name} loading="lazy" />
            </div>
            <div class="slide-body">
              <span class="role-tag">{p.role}</span>
              <div class="name">{p.name}</div>
              <div class="cred">{p.cred}</div>
              <div class="quote">{p.quote}</div>
            </div>
          </div>
        ))}
      </div>
      <button class="car-btn car-prev" id="carPrev" aria-label="Previous person">&#8249;</button>
      <button class="car-btn car-next" id="carNext" aria-label="Next person">&#8250;</button>
      <div class="car-dots" id="carDots">
        {people.map((p, i) => (
          <button aria-label={`Go to ${p.name}`} data-index={i}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  (function () {
    var viewport = document.getElementById('carViewport');
    var dotsWrap = document.getElementById('carDots');
    if (!viewport || !dotsWrap) return;

    var current = 0;
    var slides = Array.from(viewport.querySelectorAll('.slide'));
    var dots = Array.from(dotsWrap.querySelectorAll('button'));

    slides.forEach(function (slide, i) {
      slide.addEventListener('click', function () {
        if (i !== current) goTo(i);
      });
    });
    dots.forEach(function (dot, i) {
      dot.addEventListener('click', function () {
        goTo(i);
      });
    });

    function render() {
      var n = slides.length;
      slides.forEach(function (slide, i) {
        var offset = i - current;
        if (offset > n / 2) offset -= n;
        if (offset < -n / 2) offset += n;
        var abs = Math.abs(offset);
        var x = offset * 230;
        var scale = abs === 0 ? 1 : abs === 1 ? 0.78 : 0.6;
        var opacity = abs === 0 ? 1 : abs === 1 ? 0.55 : 0;
        var z = 100 - abs;
        var rot = offset * -8;
        (slide as HTMLElement).style.transform =
          'translate(-50%,-50%) translateX(' + x + 'px) scale(' + scale + ') rotateY(' + rot + 'deg)';
        (slide as HTMLElement).style.opacity = String(opacity);
        (slide as HTMLElement).style.zIndex = String(z);
        (slide as HTMLElement).style.pointerEvents = abs > 1 ? 'none' : 'auto';
        slide.classList.toggle('active', i === current);
      });
      dots.forEach(function (d, i) {
        d.classList.toggle('active', i === current);
      });
    }

    function goTo(i: number) {
      var n = slides.length;
      current = ((i % n) + n) % n;
      render();
    }

    document.getElementById('carPrev')?.addEventListener('click', function () {
      goTo(current - 1);
    });
    document.getElementById('carNext')?.addEventListener('click', function () {
      goTo(current + 1);
    });

    document.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') goTo(current - 1);
      if (e.key === 'ArrowRight') goTo(current + 1);
    });

    // touch / swipe support
    var startX = 0,
      dragging = false,
      deltaX = 0;

    viewport.addEventListener(
      'touchstart',
      function (e) {
        startX = e.touches[0].clientX;
        dragging = true;
        deltaX = 0;
      },
      { passive: true }
    );
    viewport.addEventListener(
      'touchmove',
      function (e) {
        if (!dragging) return;
        deltaX = e.touches[0].clientX - startX;
      },
      { passive: true }
    );
    viewport.addEventListener('touchend', function () {
      if (!dragging) return;
      dragging = false;
      if (deltaX > 50) goTo(current - 1);
      else if (deltaX < -50) goTo(current + 1);
    });

    // mouse drag support (desktop swipe)
    var mdown = false,
      mstartX = 0,
      mDeltaX = 0;
    viewport.addEventListener('mousedown', function (e) {
      mdown = true;
      mstartX = e.clientX;
      mDeltaX = 0;
    });
    window.addEventListener('mousemove', function (e) {
      if (mdown) mDeltaX = e.clientX - mstartX;
    });
    window.addEventListener('mouseup', function () {
      if (!mdown) return;
      mdown = false;
      if (mDeltaX > 60) goTo(current - 1);
      else if (mDeltaX < -60) goTo(current + 1);
    });

    render();
  })();
</script>
