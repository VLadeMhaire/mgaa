---
---
<section class="hero">
  <div class="hero-bg-photo" data-parallax="0.14"></div>
  <div class="grid-bg"></div>
  <div class="hero-inner">
    <div>
      <div class="eyebrow-line" data-reveal="up"><span class="dot"></span>TAX, BIR &amp; SEC COMPLIANCE FOR PHILIPPINE BUSINESSES</div>
      <h1 data-split style="--base:150ms">Compliance handled.<br />Audits <em>survived.</em><br />Your business protected.</h1>
      <p class="lede" data-reveal="up" style="--d:800ms">Medez-Galanto &amp; Associates (MGAA) is a CPA and legal team in the Philippines that manages BIR, SEC, SSS, PhilHealth, Pag-IBIG and DOLE compliance for growing businesses — so penalties, audits, and paperwork never slow you down.</p>
      <div class="hero-ctas" data-stagger="120" data-stagger-base="950">
        <a href="#contact" class="btn-primary">Schedule a Consultation</a>
        <a href="#expertise" class="btn-ghost">Explore Our Services</a>
      </div>
    </div>
    <div class="hero-visual" data-reveal="zoom" style="--d:350ms">
      <div class="hero-photo-frame">
        <div class="hero-photo-heading">
          <span class="kicker">LEADERSHIP PANEL</span>
          <h4>Six Experts. <span>One Comprehensive Team.</span></h4>
        </div>
        <div class="hero-photo-imgwrap" data-reveal="image" style="--d:950ms">
          <img src="/images/hero-team.jpg" alt="The MGAA leadership and expert panel" />
        </div>
        <div class="hero-photo-caption">
          <span class="l1">CPAs, legal counsel &amp; strategists</span>
          <span class="l2">Meet the panel &darr;</span>
        </div>
      </div>
    </div>
  </div>
  <div class="stat-strip">
    <div class="wrap" data-stagger="110">
      <div class="stat"><div class="num">6</div><div class="lbl">CPAs &amp; Legal Experts</div></div>
      <div class="stat"><div class="num">7+</div><div class="lbl">Agencies We Navigate</div></div>
      <div class="stat"><div class="num">4</div><div class="lbl">Core Practice Areas</div></div>
      <div class="stat"><div class="num">360&deg;</div><div class="lbl">Compliance Coverage</div></div>
    </div>
  </div>
</section>
