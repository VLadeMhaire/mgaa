---
const pillars = [
  {
    icon: '<path d="M3 12l7-8 7 8-7 8-7-8z"/><path d="M17 8l4 4-4 4"/>',
    title: 'Navigate Change',
    body: 'Ahead of new regulations, not behind them.',
  },
  {
    icon: '<path d="M12 3l7 3v6c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3z"/>',
    title: 'Strengthen Governance',
    body: 'Frameworks built for long-term resilience.',
  },
  {
    icon: '<path d="M9 11l2 2 4-4"/><circle cx="12" cy="12" r="9"/>',
    title: 'Stay Audit-Ready',
    body: 'Documentation and controls, always in order.',
  },
];
---
<section class="philosophy" id="philosophy">
  <div class="philosophy-bg-photo"></div>
  <div class="grid-bg"></div>
  <div class="wrap" style="position:relative;z-index:2;">
    <span class="kicker">OPERATING PHILOSOPHY</span>
    <h2>Navigate change. Strengthen governance. Stay audit-ready.</h2>
    <p class="lede">We empower businesses to operate with clarity and confidence, ensuring their financial operations remain compliant, secure, and prepared for future growth.</p>
    <div class="pillars">
      {pillars.map((p) => (
        <div class="pillar">
          <div class="ico">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#5fb2ff" stroke-width="1.8" set:html={p.icon} />
          </div>
          <h4>{p.title}</h4>
          <p>{p.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>
